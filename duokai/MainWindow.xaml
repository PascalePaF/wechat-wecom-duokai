<Window x:Class="WechatDuokai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信 · 企业微信多开助手 V1.0.5"
        Width="901" Height="513" MinWidth="901" MinHeight="513"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">
    <Grid x:Name="ScaleViewport" Background="{DynamicResource WindowBackgroundBrush}"
          ClipToBounds="True" SizeChanged="ScaleViewport_SizeChanged">
        <Grid x:Name="ScaledRoot" Width="901" Height="513"
              HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="InterfaceScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowTopBrush}" Padding="28,20,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="17" Background="{DynamicResource SelectionBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <TextBlock Text="双" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,3,18,0" VerticalAlignment="Top">
                    <TextBlock Text="微信 · 企业微信多开助手" Style="{StaticResource WindowTitleStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="按目标数量智能补开 · 关闭一个，也只补回一个" Margin="0,7,0,0"
                               Style="{StaticResource BodyStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="VersionBadge" Height="30" Padding="13,0" CornerRadius="15"
                            Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="V1.0.5" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ThemeButton" Margin="10,0,0,0" Style="{StaticResource PillButtonStyle}"
                            AutomationProperties.Name="切换日间或夜间主题" Click="ThemeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Text="☾" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="ThemeLabel" Text="夜间" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}" />

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="28,12,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ApplicationsColumn" Width="2.4*" />
                    <ColumnDefinition x:Name="WorkspaceGapColumn" Width="18" />
                    <ColumnDefinition x:Name="CountColumn" Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ApplicationsPanel" Grid.Row="0" Grid.Column="0">
                    <Border Style="{StaticResource ShadowLayerStyle}" />
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58*" />
                                <RowDefinition Height="86*" />
                                <RowDefinition Height="12*" />
                                <RowDefinition Height="86*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="应用" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="自动识别官方客户端，也可以手动指定安装位置" Margin="0,7,0,0"
                                           Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border x:Name="WeChatClientCard" Grid.Row="1" Style="{StaticResource RaisedCardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="118" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="13" Background="#E9F8F1">
                                        <Image Source="Resources/WeChat.png" Width="36" Height="36" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,1,8,0">
                                        <TextBlock Text="微信" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WeChatStatus" Text="正在检测…" FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="WeChatPath" Text="正在查找安装位置" FontSize="10" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <Button x:Name="WeChatSelectButton" Grid.Column="2" Content="…"
                                            Style="{StaticResource TextButtonStyle}" FontSize="18"
                                            ToolTip="手动选择官方微信程序" AutomationProperties.Name="选择官方微信程序"
                                            Click="WeChatSelectButton_Click" />
                                    <Button x:Name="WeChatButton" Grid.Column="3" Height="40"
                                            Style="{StaticResource PrimaryButtonStyle}" Content="启动 / 补开"
                                            AutomationProperties.Name="启动或补开微信" Click="WeChatButton_Click" />
                                </Grid>
                            </Border>

                            <Border x:Name="WeComClientCard" Grid.Row="3" Style="{StaticResource RaisedCardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="118" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="13" Background="#EAF5FC">
                                        <Image Source="Resources/WXWork.png" Width="36" Height="36" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,1,8,0">
                                        <TextBlock Text="企业微信" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WeComStatus" Text="正在检测…" FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="WeComPath" Text="正在查找安装位置" FontSize="10" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <Button x:Name="WeComSelectButton" Grid.Column="2" Content="…"
                                            Style="{StaticResource TextButtonStyle}" FontSize="18"
                                            ToolTip="手动选择官方企业微信程序" AutomationProperties.Name="选择官方企业微信程序"
                                            Click="WeComSelectButton_Click" />
                                    <Button x:Name="WeComButton" Grid.Column="3" Height="40"
                                            Style="{StaticResource PrimaryButtonStyle}" Content="启动 / 补开"
                                            AutomationProperties.Name="启动或补开企业微信" Click="WeComButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="CountPanel" Grid.Row="0" Grid.Column="2">
                    <Border Style="{StaticResource ShadowLayerStyle}" />
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="76" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="目标窗口数" Style="{StaticResource SectionTitleStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="微信与企微分别补齐" Margin="0,6,0,0" TextAlignment="Center"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DecreaseButton" Style="{StaticResource StepButtonStyle}" Content="−"
                                        AutomationProperties.Name="减少目标窗口数" Click="DecreaseButton_Click" />
                                <TextBox x:Name="TargetCountBox" Grid.Column="1" Margin="8,0" FontSize="30"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                         Background="Transparent" BorderThickness="0" TextAlignment="Center"
                                         VerticalContentAlignment="Center" MaxLength="2" Text="2"
                                         AutomationProperties.Name="目标窗口数量"
                                         PreviewTextInput="TargetCountBox_PreviewTextInput"
                                         LostKeyboardFocus="TargetCountBox_LostKeyboardFocus"
                                         TextChanged="TargetCountBox_TextChanged" />
                                <Button x:Name="IncreaseButton" Grid.Column="2" Style="{StaticResource StepButtonStyle}"
                                        Content="+" AutomationProperties.Name="增加目标窗口数"
                                        Click="IncreaseButton_Click" />
                            </Grid>
                            <Border Grid.Row="3" Margin="0,4,0,0" Padding="10,7" CornerRadius="10"
                                    Background="{DynamicResource SuccessSurfaceBrush}">
                                <TextBlock Text="●  数量会自动保存" FontSize="11" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Row="5">
                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,14" />
                                <TextBlock Text="窗口误关后再次点击，即可单独补回" TextAlignment="Center"
                                           TextWrapping="Wrap" LineHeight="19" Style="{StaticResource BodyStyle}" />
                                <TextBlock Text="支持 1–10 个窗口" Margin="0,8,0,0" TextAlignment="Center"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>

        <Grid x:Name="SettingsWorkspace" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed">
            <Border Style="{StaticResource ShadowLayerStyle}" />
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="外观与版本检查 · 所有选项只保存在本机" Margin="0,7,0,0"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="28" Padding="12,0" CornerRadius="14"
                                Background="{DynamicResource SelectionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="V1.0.5" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource RaisedCardStyle}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="界面主题" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="可跟随 Windows，也可固定为日间或夜间"
                                           Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" />
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <RadioButton x:Name="SystemThemeRadio" GroupName="ThemePreference"
                                                 Content="跟随 Windows 系统" Tag="System"
                                                 Style="{StaticResource PremiumRadioStyle}"
                                                 Checked="ThemePreference_Checked" />
                                    <RadioButton x:Name="LightThemeRadio" GroupName="ThemePreference"
                                                 Content="日间主题" Tag="Light" Margin="0,9,0,0"
                                                 Style="{StaticResource PremiumRadioStyle}"
                                                 Checked="ThemePreference_Checked" />
                                    <RadioButton x:Name="DarkThemeRadio" GroupName="ThemePreference"
                                                 Content="夜间主题" Tag="Dark" Margin="0,9,0,0"
                                                 Style="{StaticResource PremiumRadioStyle}"
                                                 Checked="ThemePreference_Checked" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="主题选择会自动保存" Style="{StaticResource CaptionStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource RaisedCardStyle}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="版本与隐私" FontSize="14" FontWeight="SemiBold" />
                                <CheckBox x:Name="AutoUpdateCheckBox" Grid.Row="1" Margin="0,15,0,0"
                                          Content="启动时自动检查新版本"
                                          Style="{StaticResource PremiumCheckBoxStyle}"
                                          Checked="AutoUpdateCheckBox_Changed"
                                          Unchecked="AutoUpdateCheckBox_Changed" />
                                <TextBlock Grid.Row="2" Margin="28,9,0,0"
                                           Text="仅读取 GitHub Release 版本号，不会静默下载、安装或执行文件。"
                                           TextWrapping="Wrap" LineHeight="17" Style="{StaticResource CaptionStyle}" />
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SettingsReleaseButton" Content="打开发布页 ↗"
                                            Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="从设置打开 GitHub 发布版本"
                                            Click="ReleaseButton_Click" />
                                    <Button x:Name="CheckUpdateButton" Content="立即检查"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            AutomationProperties.Name="立即检查 GitHub 新版本"
                                            Click="CheckUpdateButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WindowTopBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock x:Name="FooterWeChatCount" Text="当前微信窗口 0 个" FontSize="10.5"
                               TextAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="FooterWeComCount" Text="当前企业微信窗口 0 个" Margin="0,4,0,0"
                               FontSize="10.5" TextAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="FooterStatus" Grid.Column="2" Text="就绪 · 选择数量后启动"
                           Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="DiagnosticsButton" Grid.Column="3" Margin="0,0,12,0" Content="诊断"
                        Style="{StaticResource TextButtonStyle}" AutomationProperties.Name="生成本地诊断报告"
                        ToolTip="在程序目录生成本地报告，不会上传" Click="DiagnosticsButton_Click" />
                <Button x:Name="ReleaseButton" Grid.Column="4" Margin="0,0,12,0" Content="发布版本 ↗"
                        Style="{StaticResource TextButtonStyle}" AutomationProperties.Name="打开 GitHub 发布版本"
                        ToolTip="自动检查更新；下载只在 GitHub 完成" Click="ReleaseButton_Click" />
                <Button x:Name="SettingsButton" Grid.Column="5" Content="设置"
                        Style="{StaticResource TextButtonStyle}" AutomationProperties.Name="打开设置界面"
                        ToolTip="切换主题和版本检查选项" Click="SettingsButton_Click" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
