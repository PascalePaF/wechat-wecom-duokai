<Window x:Class="WechatDuokai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信 · 企业微信多开助手 V1.0.2"
        Width="900" Height="590"
        MinWidth="900" MinHeight="590" MaxWidth="900" MaxHeight="590"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowTopBrush}" Padding="28,20,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{DynamicResource SelectionBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="双" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,3,0,0" VerticalAlignment="Top">
                    <TextBlock Text="微信 · 企业微信多开助手" Style="{StaticResource WindowTitleStyle}" />
                    <TextBlock Text="按目标数量智能补开 · 关闭一个，也只补回一个" Margin="0,7,0,0"
                               Style="{StaticResource BodyStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="30" Padding="13,0" CornerRadius="15"
                            Background="{DynamicResource SelectionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="V1.0.2" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ThemeButton" Margin="10,0,0,0" Style="{StaticResource PillButtonStyle}"
                            AutomationProperties.Name="切换日间或夜间主题" Click="ThemeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Text="☾" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="ThemeLabel" Text="夜间" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="1" Margin="28,24,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="238" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border Style="{StaticResource ShadowLayerStyle}" />
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="应用" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="选择客户端后，系统只会补齐尚未运行的窗口" Margin="0,7,0,0"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource RaisedCardStyle}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="13" Background="#E9F8F1">
                                    <Image Source="Resources/WeChat.png" Width="36" Height="36"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,1,14,0">
                                    <TextBlock Text="微信" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WeChatStatus" Text="正在检测…" FontSize="11" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="WeChatPath" Text="正在查找安装位置" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="WeChatButton" Grid.Column="2" Height="40"
                                        Style="{StaticResource PrimaryButtonStyle}" Content="启动 / 补开"
                                        AutomationProperties.Name="启动或补开微信" Click="WeChatButton_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource RaisedCardStyle}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="13" Background="#EAF5FC">
                                    <Image Source="Resources/WXWork.png" Width="36" Height="36"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,1,14,0">
                                    <TextBlock Text="企业微信" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WeComStatus" Text="正在检测…" FontSize="11" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="WeComPath" Text="正在查找安装位置" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="WeComButton" Grid.Column="2" Height="40"
                                        Style="{StaticResource PrimaryButtonStyle}" Content="启动 / 补开"
                                        AutomationProperties.Name="启动或补开企业微信" Click="WeComButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource ShadowLayerStyle}" />
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="76" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="目标窗口数" Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DecreaseButton" Style="{StaticResource StepButtonStyle}"
                                    Content="−" AutomationProperties.Name="减少目标窗口数"
                                    Click="DecreaseButton_Click" />
                            <TextBox x:Name="TargetCountBox" Grid.Column="1" Margin="8,0"
                                     FontFamily="{StaticResource AppFont}" FontSize="30" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}" Background="Transparent"
                                     BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center"
                                     MaxLength="2" Text="2" AutomationProperties.Name="目标窗口数量"
                                     PreviewTextInput="TargetCountBox_PreviewTextInput"
                                     LostKeyboardFocus="TargetCountBox_LostKeyboardFocus"
                                     TextChanged="TargetCountBox_TextChanged" />
                            <Button x:Name="IncreaseButton" Grid.Column="2" Style="{StaticResource StepButtonStyle}"
                                    Content="+" AutomationProperties.Name="增加目标窗口数"
                                    Click="IncreaseButton_Click" />
                        </Grid>

                        <Border Grid.Row="3" Margin="0,4,0,0" Padding="10,7" CornerRadius="10"
                                Background="{DynamicResource SuccessSurfaceBrush}">
                            <TextBlock Text="●  数量会自动保存" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>

                        <StackPanel Grid.Row="5">
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="窗口误关后再次点击，即可单独补回" TextAlignment="Center"
                                       TextWrapping="Wrap" LineHeight="19" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="支持 1–10 个窗口" Margin="0,8,0,0" TextAlignment="Center"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WindowTopBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="FooterStatus" Grid.Column="1" Text="就绪 · 选择数量后启动"
                           Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyStyle}" />
                <Button Grid.Column="2" Content="开源项目 ↗" Style="{StaticResource TextButtonStyle}"
                        AutomationProperties.Name="打开 GitHub 开源项目" Click="ProjectButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
