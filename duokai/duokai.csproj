<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>wechat_duokai</AssemblyName>
    <RootNamespace>WechatDuokai.App</RootNamespace>
    <StartupObject>WechatDuokai.App.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <AssemblyVersion>$(WechatDuokaiVersion).0</AssemblyVersion>
    <FileVersion>$(WechatDuokaiVersion).0</FileVersion>
    <Version>$(WechatDuokaiVersion)</Version>
    <Company>wechat_duokai contributors</Company>
    <Product>微窗助手</Product>
    <Description>轻量的微信与企业微信多开、按缺口补开与分端退出工具</Description>
    <Copyright>Copyright © CN-Root and contributors 2022-2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WechatDuokai.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\WechatDuokai.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\WpfPresentation.cs" Link="Presentation\WpfPresentation.cs" />
    <Compile Include="..\shared\WindowsShellIntegration.cs" Link="Presentation\WindowsShellIntegration.cs" />
    <Compile Include="..\shared\WindowsStartupIntegration.cs" Link="Presentation\WindowsStartupIntegration.cs" />
    <Page Include="..\shared\ThemeResources.xaml" Link="Themes\ThemeResources.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\WeChat.png" />
    <None Remove="Resources\WXWork.png" />
    <None Remove="Resources\WeichuangLogo.png" />
    <Resource Include="Resources\WeChat.png" />
    <Resource Include="Resources\WXWork.png" />
    <Resource Include="Resources\WeichuangLogo.png" />
    <Resource Include="favicon.ico" Link="Resources\AppIcon.ico" />
  </ItemGroup>
</Project>
