<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F8F7" />
    <SolidColorBrush x:Key="WindowTopBrush" Color="#FAFCFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FBFDFC" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFF6F4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE9E5" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C4D8D2" />
    <SolidColorBrush x:Key="TextBrush" Color="#18221F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E6C67" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#899791" />
    <SolidColorBrush x:Key="AccentBrush" Color="#168F55" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#117945" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0E663A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#168F55" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E7F7EF" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2F78D5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B66A12" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C54848" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#AE3A3A" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF1F1" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F7F0" />
    <SolidColorBrush x:Key="WeChatIconSurfaceBrush" Color="#E4F8EE" />
    <SolidColorBrush x:Key="WeComIconSurfaceBrush" Color="#E7F2FE" />
    <SolidColorBrush x:Key="QqIconSurfaceBrush" Color="#E7F2FE" />
    <Color x:Key="ShadowColor">#24304B43</Color>
    <Visibility x:Key="HalloweenDecorationVisibility">Collapsed</Visibility>

