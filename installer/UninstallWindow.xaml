<Window x:Class="WechatDuokai.Installer.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="完全卸载 · 开开助手"
        Width="810" Height="680" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource WindowTopBrush}" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Width="56" Height="56" Source="Resources/KaikaiLogo.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="17,2,0,0">
                    <TextBlock Text="完全卸载与清理" Style="{StaticResource WindowTitleStyle}" />
                    <TextBlock Text="只处理通过项目标记和精确路径校验的内容" Margin="0,7,0,0"
                               Style="{StaticResource BodyStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="30" Padding="13,0" CornerRadius="15" Background="{DynamicResource SuccessSurfaceBrush}">
                        <TextBlock Text="✓ 安全校验已启用" FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ThemeButton" Margin="10,0,0,0" Style="{StaticResource PillButtonStyle}" Click="ThemeButton_Click"
                            AutomationProperties.Name="切换日间或夜间主题">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Text="☾" Margin="0,0,6,0" />
                            <TextBlock x:Name="ThemeLabel" Text="夜间" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="1" Margin="26,22,26,18">
            <Border Style="{StaticResource ShadowLayerStyle}" />
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="22,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="94" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="112" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="选择清理范围" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="两个选项都会清理已安装程序、绿色版、发布包、快捷方式与用户设置"
                                   Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource RaisedCardStyle}" Padding="16,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="KeepSourceOption" GroupName="CleanupScope" IsChecked="True"
                                         Content="删除程序与全部发布包，保留源码"
                                         Style="{StaticResource PremiumRadioStyle}" />
                            <TextBlock Grid.Row="1" Margin="28,8,0,0"
                                       Text="推荐。保留本地 Git 仓库和源码，只清理可重新生成的内容。"
                                       TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                    </Border>

                    <Border x:Name="DeleteSourceCard" Grid.Row="4" Style="{StaticResource RaisedCardStyle}"
                            Background="{DynamicResource DangerSurfaceBrush}" Padding="16,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="DeleteSourceOption" GroupName="CleanupScope"
                                         Content="全部删除，包括源码与全部发布包"
                                         Style="{StaticResource PremiumRadioStyle}" />
                            <TextBlock Grid.Row="1" Margin="28,7,0,0"
                                       Text="不可撤销；仅当源码目录通过专用标记与结构校验时可选。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="11" />
                            <CheckBox x:Name="ConfirmSourceDeletion" Grid.Row="2" Margin="28,9,0,0"
                                      Content="我确认永久删除本地源码（包括未提交的修改）"
                                      Style="{StaticResource PremiumCheckBoxStyle}" Visibility="Collapsed"
                                      Checked="ConfirmSourceDeletion_Changed" Unchecked="ConfirmSourceDeletion_Changed" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SourceUnavailableText" Grid.Row="5" Margin="3,10,0,0" Visibility="Collapsed"
                               Text="当前没有找到通过安全校验的源码目录，因此已禁用“全部删除”。"
                               Foreground="{DynamicResource WarningBrush}" FontSize="11" />

                    <Border Grid.Row="7" Padding="13,10" CornerRadius="12" Background="{DynamicResource SurfaceHoverBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="将处理的已验证位置" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="VerifiedPathsText" Grid.Row="1" Margin="0,6,0,0" FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WindowTopBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="106" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="126" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="●  删除前还会进行最后一次确认" VerticalAlignment="Center"
                           Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                <Button Grid.Column="1" Content="取消" Height="40" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="CleanupButton" Grid.Column="3" Content="开始清理" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}" Click="CleanupButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
