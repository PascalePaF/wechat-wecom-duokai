<Window x:Class="WechatDuokai.Installer.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信 · 企业微信多开助手 V1.0.7 安装程序"
        Width="780" Height="570" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource WindowTopBrush}" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource SelectionBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <TextBlock x:Name="HeaderGlyph" Text="装" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="17,2,0,0">
                    <TextBlock x:Name="HeaderTitle" Text="安装多开助手" Style="{StaticResource WindowTitleStyle}" />
                    <TextBlock x:Name="HeaderSubtitle" Text="选择专用位置 · 当前用户安装 · 无需管理员权限" Margin="0,7,0,0"
                               Style="{StaticResource BodyStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="30" Padding="13,0" CornerRadius="15" Background="{DynamicResource SelectionBrush}">
                        <TextBlock x:Name="VersionText" Text="V1.0.7" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ThemeButton" Margin="10,0,0,0" Style="{StaticResource PillButtonStyle}" Click="ThemeButton_Click"
                            AutomationProperties.Name="切换日间或夜间主题">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Text="☾" Margin="0,0,6,0" />
                            <TextBlock x:Name="ThemeLabel" Text="夜间" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="1" Margin="26,22,26,18">
            <Border Style="{StaticResource ShadowLayerStyle}" />
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="22,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LocationTitle" Text="安装位置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="LocationSubtitle" Text="请选择或新建一个空的专用文件夹" Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource RaisedCardStyle}" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="InstallPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Foreground="{DynamicResource TextBrush}" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Margin="10,0,0,0" Height="38"
                                    Style="{StaticResource SecondaryButtonStyle}" Content="选择文件夹"
                                    AutomationProperties.Name="选择本地安装文件夹" Click="BrowseButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="LocationHint" Grid.Row="3" Margin="2,10,0,15"
                               Text="为保护已有文件，不能安装到磁盘根目录、源码目录或含其他内容的普通文件夹。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />
                    <Rectangle Grid.Row="4" Fill="{DynamicResource BorderBrush}" />
                    <CheckBox x:Name="DesktopShortcutCheckBox" Grid.Row="5" Margin="2,17,0,0"
                              IsChecked="True" Content="创建桌面快捷方式" Style="{StaticResource PremiumCheckBoxStyle}" />

                    <Border x:Name="CompletionPanel" Grid.Row="6" Margin="0,16,0,0" Padding="14,10"
                            CornerRadius="12" Background="{DynamicResource SuccessSurfaceBrush}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="CompletionTitle" Text="安装已经完成，应用尚未启动" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock x:Name="CompletionSubtitle" Text="点击下方“确认并启动”才会打开应用。" Margin="0,4,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WindowTopBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备安装" Margin="10,0,12,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStyle}" />
                <Button x:Name="SecondaryButton" Grid.Column="2" Width="106" Height="40" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="SecondaryButton_Click" />
                <Button x:Name="PrimaryButton" Grid.Column="3" Width="126" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}" Content="立即安装"
                        AutomationProperties.Name="安装或确认启动" Click="PrimaryButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
